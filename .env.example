VITE_GOOGLE_CLIENT_ID=your-web-application-client-id.apps.googleusercontent.com

# Muse sync relay (server-only Vercel environment variables; never prefix with VITE_).
# MUSE_SYNC_KEY=long-random-key-for-muse
# PACEBOARD_SYNC_KEY=different-long-random-key-for-this-browser
# Upstash credentials (UPSTASH_REDIS_REST_URL/TOKEN or KV_REST_API_URL/TOKEN) come from the Vercel Marketplace integration.

# Optional for local development: proxy /api to the deployed relay.
# MUSE_RELAY_DEV_TARGET=https://your-paceboard-deployment.vercel.app
